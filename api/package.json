{
  "name": "chatcafe-api",
  "type": "module",
  "scripts": {
    "format": "prettier --write .",
    "test": "node --import tsx/esm --test",
    "dev": "dotenvx run -f .env.development -- node --watch --import tsx/esm index.ts",
    "prod": "dotenvx run -f .env.production --overload -- node --import tsx/esm index.ts",
    "encrypt:dev": "dotenvx encrypt -f .env.development",
    "encrypt:prod": "dotenvx encrypt -f .env.production",
    "decrypt:dev": "dotenvx decrypt -f .env.development",
    "decrypt:prod": "dotenvx decrypt -f .env.production"
  },
  "devDependencies": {
    "@types/crypto-js": "^4.2.2",
    "@types/uuid": "^9.0.8",
    "exact-mirror": "0.2.7",
    "lint-staged": "^15.2.2",
    "prettier": "3.2.5",
    "prisma": "^5.13.0",
    "tsx": "^4.22.4"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.73",
    "@alicloud/dysmsapi20170525": "2.0.24",
    "@alicloud/openapi-client": "^0.4.15",
    "@alicloud/tea-util": "^1.4.11",
    "@dotenvx/dotenvx": "^1.31.0",
    "@elysiajs/cors": "^1.0.2",
    "@elysiajs/cron": "^1.0.3",
    "@elysiajs/jwt": "^1.0.2",
    "@elysiajs/node": "^1.4.5",
    "@elysiajs/stream": "^1.0.2",
    "@ethan-utils/pay-gateway": "^1.4.2",
    "@prisma/client": "^5.13.0",
    "ai": "^6.0.208",
    "crypto-js": "^4.2.0",
    "elysia": "^1.0.15",
    "moment": "^2.30.1",
    "safe-eval": "^0.4.1",
    "uuid": "^9.0.1"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,md,ts,vue,json,css}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]
  }
}
