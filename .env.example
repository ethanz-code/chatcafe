IMAGE_REGISTRY=docker.itcox.cn/chatcafe
IMAGE_TAG=latest

GATEWAY_PORT=80
POSTGRES_PORT=5432

POSTGRES_DB=chatcafe
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here

# Required by chatcafe-api to decrypt api/.env.production; never commit the real value.
DOTENV_PRIVATE_KEY_PRODUCTION=your_dotenvx_production_private_key_here
